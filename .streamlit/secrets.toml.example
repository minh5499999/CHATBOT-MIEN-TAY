# Bật "Đăng nhập bằng Gmail": chép file này thành .streamlit/secrets.toml rồi điền mã thật.
# KHÔNG đưa secrets.toml lên GitHub (đã có trong .gitignore). Cách lấy mã: xem README, mục "Đăng nhập bằng Gmail".

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
# chuỗi ngẫu nhiên dài; tạo bằng: .venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "THAY_BANG_CHUOI_NGAU_NHIEN"

[auth.google]
client_id = ""
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
