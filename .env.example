# Chép file này thành .env rồi điền giá trị thật. KHÔNG đưa .env lên GitHub.
# Chatbot chạy hoàn toàn trên máy, không cần khóa API.
# Tùy chọn: token Hugging Face để tải mô hình sinh vector nhanh hơn (không bắt buộc)
HF_TOKEN=

# Neo4j (kho tri thức + tìm kiếm). Neo4j Desktop: bấm Start cho instance, mật khẩu là mật khẩu đặt lúc tạo instance.
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Tai khoan, phan quyen, phien va lich su (MySQL 8 tren may)
TAI_KHOAN_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=bep_mien_tay
MYSQL_USER=bep_mien_tay_app
MYSQL_PASSWORD=
